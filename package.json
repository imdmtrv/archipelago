{
  "name": "archipelago",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @arch/web",
    "build": "npm run build -w @arch/web",
    "test": "npm run test -w @arch/engine",
    "sim": "npm run sim -w @arch/engine",
    "typecheck": "npm run typecheck -w @arch/engine && npm run typecheck -w @arch/web",
    "trailer": "node scripts/trailer/render.mjs",
    "trailer:fixtures": "tsx scripts/trailer/fixtures.ts",
    "readme:shots": "tsx scripts/readme/saves.ts && node scripts/readme/shoot.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
